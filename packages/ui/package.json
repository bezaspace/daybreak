{
  "name": "@daybreak/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Daybreak React dashboard (Phase 1+)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit && echo 'ui lint OK'",
    "test": "vitest run --passWithNoTests",
    "preview": "vite preview",
    "clean": "rm -rf dist .tsbuildinfo"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.3",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}

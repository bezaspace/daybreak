{
  "name": "@daybreak/control-plane",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Daybreak control plane — Cloudflare-Worker-compatible API (Phase 1+)",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./queue": {
      "types": "./src/queue.ts",
      "import": "./src/queue.ts"
    },
    "./idempotency": {
      "types": "./src/idempotency.ts",
      "import": "./src/idempotency.ts"
    },
    "./retry": {
      "types": "./src/retry.ts",
      "import": "./src/retry.ts"
    },
    "./tenants": {
      "types": "./src/tenants.ts",
      "import": "./src/tenants.ts"
    },
    "./budgets": {
      "types": "./src/budgets.ts",
      "import": "./src/budgets.ts"
    },
    "./cleanup": {
      "types": "./src/cleanup.ts",
      "import": "./src/cleanup.ts"
    },
    "./errors": {
      "types": "./src/errors.ts",
      "import": "./src/errors.ts"
    }
  },
  "scripts": {
    "lint": "tsc --noEmit && echo 'control-plane lint OK'",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "dev": "tsx src/server.ts",
    "build": "tsc --noEmit",
    "clean": "rm -rf dist .tsbuildinfo"
  },
  "dependencies": {
    "@daybreak/shared": "workspace:*",
    "@hono/node-server": "^2.0.12",
    "@us4/den": "^0.0.6",
    "@supabase/supabase-js": "^2.111.0",
    "@upstash/redis": "^1.38.0",
    "e2b": "^2.37.0",
    "hono": "^4.12.32"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "tsx": "^4.23.1",
    "typescript": "^5.7.3",
    "vitest": "^3.0.0"
  }
}

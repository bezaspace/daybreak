{
  "name": "@daybreak/evals",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Daybreak evaluation harness and benchmark fixtures",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "eval": "tsx src/index.ts",
    "lint": "tsc --noEmit && echo 'evals lint OK'",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "build": "tsc --noEmit",
    "clean": "rm -rf dist .tsbuildinfo"
  },
  "dependencies": {
    "@daybreak/agent-runner": "workspace:*",
    "@daybreak/shared": "workspace:*",
    "picocolors": "1.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "tsx": "^4.23.1",
    "typescript": "^5.7.3",
    "vitest": "^3.0.0"
  }
}

{
  "name": "@daybreak/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Shared types, configuration, and safety rules for Daybreak",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "lint": "tsc --noEmit && echo 'shared lint OK'",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "build": "tsc --noEmit"
  },
  "dependencies": {
    "dotenv": "16.4.7",
    "minimatch": "10.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.0"
  }
}

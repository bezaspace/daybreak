{
  "name": "@daybreak/agent-runner",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Daybreak agent runner: Pi SDK loop with safety, metrics, and checkpointing",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "spike": "tsx src/spike.ts",
    "task": "tsx src/run-task.ts",
    "sandbox": "tsx src/build-bundle.ts && tsx src/sandbox.ts",
    "lint": "tsc --noEmit && echo 'agent-runner lint OK'",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "build": "tsc --noEmit",
    "build:bundle": "tsx src/build-bundle.ts",
    "build:template": "tsx src/build-template.ts",
    "clean": "rm -rf dist .tsbuildinfo"
  },
  "dependencies": {
    "@daybreak/shared": "workspace:*",
    "@daytona/sdk": "^0.203.0",
    "@earendil-works/pi-agent-core": "0.83.0",
    "@earendil-works/pi-ai": "0.83.0",
    "@earendil-works/pi-coding-agent": "0.83.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/context-async-hooks": "^2.10.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-trace": "^2.10.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@upstash/redis": "^1.38.0",
    "e2b": "^2.37.0",
    "picocolors": "1.1.1",
    "playwright-core": "^1.62.1",
    "typebox": "^1.3.9"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "esbuild": "0.25.12",
    "tsx": "^4.23.1",
    "typescript": "^5.7.3",
    "vitest": "^3.0.0"
  }
}

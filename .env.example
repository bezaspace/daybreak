# Daybreak environment template
# Copy this file to .env and fill in the values for the phase you are running.

# ============================================================
# LLM (required for Phase 0)
# ============================================================
# Supported providers: openai, groq, openrouter, custom
LLM_PROVIDER=custom
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini

# Per-1M-token pricing for the primary model (USD). Optional; overrides LLM_PRICING for this model.
# Example: gpt-4o-mini is $0.15 input / $0.60 output per 1M tokens.
LLM_INPUT_PRICE_PER_1M=0.15
LLM_OUTPUT_PRICE_PER_1M=0.60

# Optional fallback LLM (used when the primary is rate-limited or down)
LLM_FALLBACK_PROVIDER=custom
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=
LLM_FALLBACK_INPUT_PRICE_PER_1M=0
LLM_FALLBACK_OUTPUT_PRICE_PER_1M=0

# Optional JSON pricing map keyed by provider/modelId or modelId, with a "*" wildcard.
# Example: LLM_PRICING='{"custom/gpt-4o-mini":{"input":0.15,"output":0.6},"*":{"input":0.5,"output":1.5}}'
LLM_PRICING={}

# ============================================================
# Safety / circuit breakers (Phase 0)
# ============================================================
MAX_TURNS=40
MAX_WALL_CLOCK_MINUTES=20
MAX_COST_USD=0.50
REQUIRE_APPROVAL_FOR_DESTRUCTIVE=true

# Context compaction (Phase 1)
COMPACTION_ENABLED=true
COMPACTION_RESERVE_TOKENS=4000
COMPACTION_KEEP_RECENT_TOKENS=8000
PROTECTED_BRANCHES=main,master
# Comma-separated minimatch patterns
DENYLIST_PATTERNS=.env,.env.*,*.pem,*.key,*.p12,*.pfx,.ssh/**,.git/config,**/*secret*,**/*token*,**/*password*,**/*credential*,.npmrc,.pypirc,**/*.tfvars

# Eval harness (Phase 1+)
# CONTROL_PLANE_URL=http://localhost:8787
# EVAL_TARGET_REPO=https://github.com/bezaspace/daybreak-target
# EVAL_TARGET_BRANCH=main
# EVAL_TIMEOUT_MS=600000

# CI self-heal eval harness (Phase 5)
# CI_SELF_HEAL_REAL=1
# HEAL_TARGET_REPO=https://github.com/bezaspace/daybreak-target
# HEAL_TARGET_BRANCH=main
# HEAL_TIMEOUT_MS=600000
# HEAL_POLL_INTERVAL_MS=10000
# HEAL_PR_NUMBER=42
# HEAL_HEAD_BRANCH=daybreak/ci-heal-eval-abc123
# HEAL_HEAD_SHA=abc123
# HEAL_CHECK_RUN_ID=123456789
# HEAL_CLEANUP=1

# Time-travel / checkpointing (Phase 4)
# Checkpoint frequency: "turn" saves one checkpoint per agent turn; "tool" saves after each tool call
DAYBREAK_CHECKPOINT_INTERVAL=tool
# Where to persist session JSONL snapshots: "file" keeps them local, "supabase" uploads to Supabase
DAYBREAK_SESSION_STORE_BACKEND=supabase
# Default fork strategy for cross-sandbox branches: "auto" uses git+re-install, "snapshot" forces an E2B snapshot, "git-reinstall" is the explicit default
DAYBREAK_FORK_STRATEGY=auto
# Maximum checkpoints to keep per task before older checkpoints are marked abandoned
DAYBREAK_MAX_CHECKPOINTS_PER_TASK=100

# ============================================================
# E2B sandbox execution (Phase 0 feasibility / Phase 1+)
# ============================================================
E2B_API_KEY=
# Optional: use a custom E2B template (e.g., daybreak-browser) instead of the default base template.
# The daybreak-browser template includes Node 22, Chromium, and playwright-core for the browser tool.
# Leave this blank or set to "base" unless you have built and published a custom daybreak-browser template.
E2B_TEMPLATE=base

# ============================================================
# GitHub auth and webhooks (Phase 3+)
# ============================================================
# Phase 3 uses a PAT + manually configured repo webhooks.
# GitHub App / installation-token support enables per-user repo dropdowns.
# GITHUB_APP_ID=
# Path to the PEM private key downloaded from the GitHub App settings page.
# GITHUB_PRIVATE_KEY_PATH=credentials/daybreak-local-dev.private-key.pem
# Alternatively, paste the PEM contents directly (newlines as \n).
# GITHUB_PRIVATE_KEY=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# Installation ID from the GitHub App install page URL or API.
# GITHUB_INSTALLATION_ID=
GITHUB_WEBHOOK_SECRET=
# Comma-separated allowlist of repos that may trigger webhooks, e.g. "bezaspace/daybreak-target,bezaspace/*"
GITHUB_WEBHOOK_REPO_ALLOWLIST=
# Maximum webhook-triggered tasks per repo or per sender in the last hour (default 10)
GITHUB_WEBHOOK_RATE_LIMIT=10
# How long to keep a sandbox alive after opening a PR, waiting for review feedback (ms)
REVIEW_KEEP_ALIVE_MS=900000
# A classic PAT or installation token, depending on phase
GITHUB_TOKEN=

# ============================================================
# CI self-healing (Phase 5)
# ============================================================
# Enable or disable the check_run self-heal webhook handler.
DAYBREAK_CI_SELF_HEAL_ENABLED=true
# Prefix used to identify Daybreak-created PR branches.
DAYBREAK_PR_BRANCH_PREFIX=daybreak/
# Maximum self-heal attempts per PR before the circuit breaker opens.
DAYBREAK_MAX_HEAL_ATTEMPTS_PER_PR=2
# Minimum seconds between heal attempts on the same failed commit (default 60).
DAYBREAK_HEAL_COOLDOWN_SECONDS=60
# Maximum bytes to download from a failed GitHub Actions job log (default 512 KiB).
DAYBREAK_MAX_CI_LOG_BYTES=524288
# Number of context lines to keep around each failure block when parsing logs (default 20).
DAYBREAK_CI_LOG_CONTEXT_LINES=20

# ============================================================
# Durable task queue and concurrency control (Phase 6)
# ============================================================
# Maximum tasks that may run at the same time.
DAYBREAK_MAX_CONCURRENT_TASKS=2
# How often the queue worker polls for pending tasks, in milliseconds.
DAYBREAK_QUEUE_WORKER_POLL_MS=1000
# Set to false to disable the background worker (useful for tests or single-node debugging).
DAYBREAK_QUEUE_WORKER_ENABLED=true
# Default tenant quotas (Phase 6).
DAYBREAK_DEFAULT_TENANT_DAILY_COST_USD=0.50
DAYBREAK_DEFAULT_TENANT_TASKS_PER_HOUR=10
DAYBREAK_DEFAULT_TENANT_MAX_CONCURRENT=2
# Global sandbox concurrency ceiling.
DAYBREAK_GLOBAL_MAX_CONCURRENT_SANDBOXES=5
# Fraction of MAX_COST_USD at which to emit a cost_alert (default 0.8).
DAYBREAK_COST_ALERT_THRESHOLD=0.8

# ============================================================
# Branch, sandbox, and data cleanup (Phase 6)
# ============================================================
# Days before a stale daybreak/* PR branch is deleted (default 7).
DAYBREAK_BRANCH_TTL_DAYS=7
# Minutes a sandbox can sit idle after keep-alive expires before cleanup (default 15).
DAYBREAK_SANDBOX_IDLE_TTL_MINUTES=15
# Days to retain session snapshots and active checkpoints (default 30).
DAYBREAK_DATA_RETENTION_DAYS=30
# Set to false to disable the background cleanup interval.
DAYBREAK_CLEANUP_ENABLED=true

# ============================================================
# Large-repo and compaction tuning (Phase 6 M8)
# ============================================================
# Hard caps on `read`/`write`/`edit` target files. Values beyond these limits are blocked.
DAYBREAK_MAX_FILE_READ_BYTES=200000
DAYBREAK_MAX_FILE_READ_LINES=5000
# Set to >0 to clone target repos with `--depth N` (0 means full clone).
DAYBREAK_MAX_REPO_CLONE_DEPTH=0
# Consecutive provider failures before skipping the primary LLM and fail-fast to fallback.
DAYBREAK_PROVIDER_FAILURE_THRESHOLD=3

# ============================================================
# Real-time streaming (Phase 1+)
# ============================================================
UPSTASH_REDIS_REST_URL=https://...upstash.io
UPSTASH_REDIS_TOKEN=

# ============================================================
# State / queue / tracing (Phase 2+)
# ============================================================
SUPABASE_URL=https://...supabase.co
SUPABASE_SERVICE_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# ============================================================
# Cloudflare (Phase 7)
# ============================================================
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
